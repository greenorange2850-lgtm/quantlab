# Normalize line endings across platforms
* text=auto eol=lf

# Shell scripts must stay LF
*.sh text eol=lf

# Windows scripts may keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Lockfiles
package-lock.json -diff
